# Variables de entorno para EvidenciaLocal
# Copie este archivo a .env y modifique según necesidades

# Embeddings
EMBEDDING__MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING__DIMENSION=384
EMBEDDING__BATCH_SIZE=32
EMBEDDING__NORMALIZE=true
EMBEDDING__QUERY_PREFIX=query:
EMBEDDING__PASSAGE_PREFIX=passage:
EMBEDDING__DEVICE=auto

# ChromaDB
CHROMA__PERSIST_DIRECTORY=data/chroma
CHROMA__COLLECTION_NAME=evidencialocal
CHROMA__DISTANCE_METRIC=cosine

# SQLite
SQLITE__DATABASE_PATH=data/sqlite/metadata.db
SQLITE__ENABLE_WAL=true

# llama.cpp
LLAMA_CPP__MODEL_PATH=qwen2.5-3b-instruct-q4_k_m.gguf
LLAMA_CPP__N_CTX=4096
LLAMA_CPP__N_THREADS=4
LLAMA_CPP__N_BATCH=512
LLAMA_CPP__TEMPERATURE=0.1
LLAMA_CPP__TOP_P=0.9
LLAMA_CPP__MAX_TOKENS=2048

# Indexación
INDEXING__CHUNK_SIZE=512
INDEXING__CHUNK_OVERLAP=50
INDEXING__MIN_CHUNK_SIZE=100
INDEXING__TOKENIZER_MODEL=intfloat/multilingual-e5-small

# Recuperación
RETRIEVAL__TOP_K=5
RETRIEVAL__MAX_RETRIEVALS=3
RETRIEVAL__SCORE_THRESHOLD=0.0

# Modo correctivo
CORRECTIVE__MAX_RETRIES=2
CORRECTIVE__CRITIQUE_TEMPERATURE=0.0

# Evaluación
EVALUATION__RANDOM_SEED=42
EVALUATION__BOOTSTRAP_SAMPLES=1000
EVALUATION__CONFIDENCE_LEVEL=0.95

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/evidencialocal.log